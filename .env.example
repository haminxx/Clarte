# Clarte environment template — plan Appendix B2, names only, empty values.
# Copy to .env and fill in locally. Never commit the real .env.
# Keys belong in product/.dev.vars or `wrangler secret put`, not in git.
#
# Suggested non-secret defaults (leave the values below empty in git):
#   IMAGINE_ENABLED=false
#   GOOGLE_REDIRECT_URI=https://clarte.io/auth/callback/google
#   GEMMA_MODEL=gemma-4-26b-a4b-it
#   APP_URL=https://clarte.io
#   API_URL=https://api.clarte.io
# Until clarte.io DNS is live, API_URL and NEXT_PUBLIC_CLARTE_API use the
# *.workers.dev host, and the site uses *.pages.dev.

# Vapi – voice agent (public key + assistant id go to the browser; private key and secret stay server-side)
VAPI_PUBLIC_KEY=
VAPI_ASSISTANT_ID=
VAPI_PRIVATE_KEY=
VAPI_SERVER_SECRET=

# xAI – Grok Imagine (server only; dev/test key, users bring their own key via BYOK)
XAI_API_KEY=
IMAGINE_ENABLED=

# Google OAuth login (Cloud project "PABER") + session and BYOK encryption
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
SESSION_SECRET=
KEY_ENCRYPTION_KEY=

# Google AI Studio – Gemma 4 via Gemini API
GEMINI_API_KEY=
GEMMA_MODEL=

# Public URLs
APP_URL=
API_URL=

# Cloudflare (wrangler deploys, D1, Vectorize, Workers AI)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional data keys
NASA_API_KEY=
OPENALEX_API_KEY=

# Website public config (copy into website/.env.local). Not server secrets.
# NEXT_PUBLIC_CLARTE_API is the API origin (https://api.clarte.io, the workers.dev
# host until DNS is live, or http://localhost:8787 for local dev).
# The Vapi public key and assistant id match VAPI_PUBLIC_KEY and VAPI_ASSISTANT_ID.
NEXT_PUBLIC_CLARTE_API=
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
