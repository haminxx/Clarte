# PABER environment template — plan Appendix B2. Copy to .env and fill in.
# Never commit the real .env; keys belong in .dev.vars or `wrangler secret put`.

# xAI – Grok Voice (server only; the browser gets a minted ephemeral token)
XAI_API_KEY=

# Google AI Studio – Gemma 4 via the Gemini API
GEMINI_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it

# Cloudflare (wrangler deploys, D1, Vectorize, Workers AI).
# The ingest script reads these to call Workers AI embeddings over REST.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Optional data keys (plan Appendix A4). Ingest skips these sources when unset.
NASA_API_KEY=
OPENALEX_API_KEY=
OPENALEX_MAILTO=

# Website → API Worker base URL (website/.env.local)
NEXT_PUBLIC_PABER_API=http://localhost:8787
