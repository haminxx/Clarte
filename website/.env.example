# Copy to .env.local. The browser only receives public values.
# Never put VAPI_PRIVATE_KEY, VAPI_SERVER_SECRET, or an xAI key in this file.
#
# API Worker:
# Local:    http://localhost:8787
# Deployed: https://api.clarte.io
NEXT_PUBLIC_CLARTE_API=http://localhost:8787

# Vapi Web SDK (public by design). Voice stays off until both are set.
# Text mode on /session still works without them.
NEXT_PUBLIC_VAPI_PUBLIC_KEY=
NEXT_PUBLIC_VAPI_ASSISTANT_ID=
