# Copy to .env.local. The frontend holds no secrets: it only needs the API Worker URL.
# Local:      http://localhost:8787  (product: npm run dev)
# Deployed:   https://api.clarte.io  (or https://clarte-api.<your-subdomain>.workers.dev
#             until the clarte.io zone is active on Cloudflare)
NEXT_PUBLIC_CLARTE_API=http://localhost:8787

# Public Vapi assistant id (live assistant "Clarte"). Not a secret.
NEXT_PUBLIC_VAPI_ASSISTANT_ID=f7cef3eb-dd90-4b34-8a21-690c27e99393
