  "private": true,
  "description": "Clarte frontend: landing page and session with Vapi voice or text chat",
  "license": "MIT",
  "homepage": "https://clarte.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/haminxx/Clarte.git",
